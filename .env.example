# Copy to .env and fill in. .env is gitignored.

# Pick ONE provider. groq = high quota + fastest. gemini = better Indic.
LLM_PROVIDER=groq

# https://console.groq.com/keys   (free, no card)
GROQ_API_KEY=
# Verify with `python -m app.nlp --models` — Groq retires ids without notice.
GROQ_MODEL=qwen/qwen3.8-27b

# https://aistudio.google.com/apikey   (free)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Anthropic (alternative if no Groq key is set)
ANTHROPIC_API_KEY=

# ── Optional overrides (sane defaults in code) ──
# DEDUP_LLM_PROVIDER=groq        # force a provider: groq | anthropic
# DEDUP_AUTO_MERGE=0.78          # dedup: auto-link at or above this score
# DEDUP_GREY_LOW=0.55            # dedup: below this, always a new issue
# DEDUP_ADJUDICATOR=1            # 0 disables the LLM adjudicator entirely
